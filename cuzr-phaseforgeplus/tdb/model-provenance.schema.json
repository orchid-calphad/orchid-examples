{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORCHID TDB generation and potential provenance",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "records",
    "artifact_root"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256",
          "system",
          "generation_method",
          "workflow_history",
          "tags",
          "potential",
          "variant",
          "parents",
          "review_status",
          "evidence",
          "workflow",
          "fit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tdb:sha256:[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "system": {
            "type": "string",
            "minLength": 1
          },
          "generation_method": {
            "enum": [
              "phaseforge",
              "phaseforge_plus",
              "conventional_assessment",
              "other",
              "unknown"
            ]
          },
          "workflow_history": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "potential": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "family",
                  "name",
                  "version",
                  "version_status",
                  "checkpoint",
                  "source",
                  "evidence"
                ],
                "properties": {
                  "family": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "version_status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "checkpoint": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "format": {
                        "type": "string",
                        "minLength": 1
                      },
                      "files": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "path",
                            "sha256"
                          ],
                          "properties": {
                            "path": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "format",
                      "files"
                    ],
                    "additionalProperties": false
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "variant": {
            "type": "string",
            "minLength": 1
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "review_status": {
            "enum": [
              "demonstration_only",
              "literature_assessment",
              "review_required",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "workflow": {
            "type": [
              "string",
              "null"
            ]
          },
          "fit": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_root": {
      "type": "object",
      "required": [
        "repository",
        "path"
      ],
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
